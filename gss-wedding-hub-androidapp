name: build android apk

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    name: Build Debug APK
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      # 1. Checkout repository
      - name: Checkout Repository
        uses: actions/checkout@v4

      # 2. Set up JDK 17
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      # 3. Locate Android project
      - name: Locate Android Project
        id: project
        shell: bash
        run: |
          echo "Checking repository files..."

          if [ ! -f "gradlew" ]; then
            echo "::error::gradlew not found in repository root."
            echo "Upload the Gradle Wrapper files before building."
            exit 1
          fi

          if [ ! -f "settings.gradle" ] && \
             [ ! -f "settings.gradle.kts" ]; then
            echo "::error::settings.gradle or settings.gradle.kts is missing."
            exit 1
          fi

          if [ ! -d "app" ]; then
            echo "::error::app directory not found."
            exit 1
          fi

          echo "Android project files found."

      # 4. Set up Android SDK
      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      # 5. Accept Android SDK licenses
      - name: Accept Android SDK Licenses
        shell: bash
        run: |
          yes | sdkmanager --licenses >/dev/null 2>&1 || true

      # 6. Verify Gradle Wrapper and set executable permissions
      - name: Verify Gradle Wrapper
        shell: bash
        run: |
          if [ ! -f "gradle/wrapper/gradle-wrapper.jar" ]; then
            echo "::error::gradle-wrapper.jar is missing."
            exit 1
          fi

          if [ ! -f "gradle/wrapper/gradle-wrapper.properties" ]; then
            echo "::error::gradle-wrapper.properties is missing."
            exit 1
          fi

          chmod +x gradlew

      # 7. Build Debug APK
      - name: Build Debug APK
        run: ./gradlew assembleDebug

      # 8. Upload APK Artifact
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-debug
          path: app/build/outputs/apk/debug/app-debug.apk
